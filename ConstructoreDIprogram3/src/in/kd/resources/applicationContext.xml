<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
	<bean class="in.kd.Beans.Address" id="addid">
		<constructor-arg value="kdhome"/>
		<constructor-arg value="0101"/>
		<constructor-arg value="Pune"/>
	
	</bean>
	
	<bean class="in.kd.Beans.Student" id="stdid">
	<constructor-arg value="kd"/>
	<constructor-arg value="1"/>
	<constructor-arg ref="addid"/>
	
	
	</bean>
	
</beans>
